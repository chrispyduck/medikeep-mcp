# Base URL of your MediKeep server (no /api/v1 suffix)
MEDIKEEP_URL=http://localhost:8005

# Credentials of the MediKeep account the MCP acts as
MEDIKEEP_USERNAME=
MEDIKEEP_PASSWORD=
# Base32 TOTP secret, only if the account has two-factor authentication enabled
MEDIKEEP_TOTP_SECRET=
# Alternative to username/password: a pre-issued JWT (expires with the session)
MEDIKEEP_TOKEN=

# compact (8 tools that reach every endpoint) | full (one tool per API operation)
MEDIKEEP_TOOL_MODE=compact
# Comma-separated tag filters, e.g. MEDIKEEP_EXCLUDE_TAGS=admin,frontend-logs,sso
MEDIKEEP_INCLUDE_TAGS=
MEDIKEEP_EXCLUDE_TAGS=
# auto (live spec if ENABLE_API_DOCS=true on the server, else bundled) | live | bundled
MEDIKEEP_OPENAPI_SOURCE=auto

# Block every non-GET request
MEDIKEEP_READ_ONLY=false
# Require confirm=true on DELETE operations
MEDIKEEP_REQUIRE_CONFIRM=true

MEDIKEEP_VERIFY_SSL=true
MEDIKEEP_TIMEOUT=60
MEDIKEEP_DOWNLOAD_DIR=~/Downloads/medikeep-mcp
MEDIKEEP_MAX_RESPONSE_CHARS=60000
